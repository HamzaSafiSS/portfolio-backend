# ===================================================================
# Portfolio Contact Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Do NOT commit your actual '.env' file to version control.
# ===================================================================

# Active Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Mail Server Configuration (Example: Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password

# Contact Form Mail Routing
# Destination email address that receives contact messages from visitors
MAIL_TO=recipient@example.com
# From address displayed on the outgoing notification email
MAIL_FROM=your-email@gmail.com

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

