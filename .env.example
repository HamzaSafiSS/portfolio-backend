# ===================================================================
# Portfolio Contact Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Do NOT commit your actual '.env' file to version control.
# ===================================================================

# Active Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Brevo (Sendinblue) SMTP Configuration
# In Brevo: Go to Settings -> SMTP & API -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USERNAME=your-brevo-login-email@domain.com
SMTP_PASSWORD=your-brevo-master-smtp-key

# Contact Email Routing
# MAIL_FROM: Must match a verified Sender or Domain in Brevo (Senders & IP -> Senders)
MAIL_FROM=verified-sender@yourdomain.com
# CONTACT_RECEIVER_EMAIL: Your personal inbox where messages will be delivered
CONTACT_RECEIVER_EMAIL=your-personal-email@domain.com

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (Submissions allowed per window in seconds per IP)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
